# Load these variables through your IDE or terminal; Spring Boot does not load .env automatically.
DB_URL=jdbc:postgresql://YOUR_POSTGRES_HOST:5432/postgres?sslmode=require
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
JPA_SHOW_SQL=false
HIBERNATE_SQL_LOG_LEVEL=WARN

JWT_SECRET=YOUR_JWT_SECRECT