        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    MANAGERS {\n        uuid manager_id PK\n        string full_name\n        string phone\n        string email\n        string status\n    }\n\n    BRANCHES {\n        uuid branch_id PK\n        uuid manager_id FK\n        string branch_code\n        string branch_name\n        string address\n        text description\n        string status\n    }\n\n    ROOM_TYPES {\n        uuid room_type_id PK\n        string type_name\n        text description\n        int default_capacity\n        text features\n    }\n\n    ROOMS {\n        uuid room_id PK\n        uuid branch_id FK\n        uuid manager_id FK\n        uuid room_type_id FK\n        string room_code\n        decimal reference_price\n        int capacity\n        string status\n        text description\n    }\n\n    ROOM_SLOTS {\n        uuid room_slot_id PK\n        uuid room_id FK\n        string slot_code\n        string slot_name\n        string status\n        text description\n    }\n\n    TENANTS {\n        uuid tenant_id PK\n        string full_name\n        date date_of_birth\n        string gender\n        string phone\n        string email\n        string identity_document\n        string status\n    }\n\n    APPOINTMENT {\n        uuid appointment_id PK\n        uuid tenant_id FK\n        uuid room_id FK\n        timestamp appointment_at\n        string status\n        text note\n    }\n\n    BOOKINGS {\n        uuid booking_id PK\n        uuid tenant_id FK\n        uuid room_id FK\n        timestamp booked_at\n        date expected_start_date\n        decimal deposit_amount\n        string status\n        text note\n    }\n\n    CONTRACTS {\n        uuid contract_id PK\n        uuid booking_id FK \&quot;unique - booking khoi tao contract\&quot;\n        uuid manager_id FK\n        date start_date\n        date end_date\n        decimal monthly_rent\n        decimal deposit_amount\n        text payment_terms\n        text terms\n        string status\n    }\n\n    CONTRACT_TENANTS {\n        uuid contract_tenant_id PK\n        uuid contract_id FK\n        uuid tenant_id FK\n        uuid source_booking_id FK \&quot;nullable unique\&quot;\n        string role\n        date joined_date\n        date planned_leave_date\n        date actual_leave_date\n        string status\n        text note\n    }\n\n    ROOM_SLOT_OCCUPANCIES {\n        uuid occupancy_id PK\n        uuid room_slot_id FK\n        uuid contract_tenant_id FK\n        date start_date\n        date planned_end_date\n        date actual_end_date\n        string status\n        text note\n    }\n\n    SERVICES {\n        uuid service_id PK\n        string service_name\n        text description\n        string unit\n        string billing_method\n        decimal reference_price\n        string status\n    }\n\n    ROOM_SERVICES {\n        uuid room_service_id PK\n        uuid room_id FK\n        uuid service_id FK\n        date start_date\n        date end_date\n        string status\n        text billing_config\n    }\n\n    ROOM_SERVICE_CHARGES {\n        uuid room_service_charge_id PK\n        uuid room_service_id FK\n        date billing_period\n        decimal start_reading\n        decimal end_reading\n        decimal usage_quantity\n        decimal unit_price\n        decimal total_amount\n    }\n\n    CONTRACT_SERVICES {\n        uuid contract_service_id PK\n        uuid contract_id FK\n        uuid service_id FK\n        date start_date\n        date end_date\n        decimal agreed_unit_price\n        string billing_cycle\n        string status\n    }\n\n    INVOICES {\n        uuid invoice_id PK\n        uuid contract_id FK\n        date billing_period\n        date issued_date\n        date due_date\n        decimal subtotal_amount\n        decimal adjustment_amount\n        decimal total_amount\n        string status\n    }\n\n    INVOICE_ITEMS {\n        uuid invoice_item_id PK\n        uuid invoice_id FK\n        uuid room_service_charge_id FK \&quot;nullable\&quot;\n        uuid contract_service_id FK \&quot;nullable\&quot;\n        string item_type\n        text description\n        decimal quantity\n        decimal unit_price\n        decimal amount\n    }\n\n    PAYMENTS {\n        uuid payment_id PK\n        uuid invoice_id FK\n        uuid payer_contract_tenant_id FK\n        decimal amount\n        timestamp paid_at\n        string payment_method\n        string transaction_reference\n        string status\n        text note\n    }\n\n    FURNITURES {\n        uuid furniture_id PK\n        uuid room_id FK\n        string furniture_name\n        string furniture_type\n        string asset_code\n        string serial_number\n        date purchase_date\n        decimal asset_value\n        string condition\n        string status\n    }\n\n    FURNITURE_WARRANTIES {\n        uuid warranty_id PK\n        uuid furniture_id FK\n        string warranty_provider\n        date start_date\n        date end_date\n        text warranty_terms\n        string warranty_code\n    }\n\n    REPORT_REQUESTS {\n        uuid report_request_id PK\n        uuid tenant_id FK\n        uuid room_id FK\n        string request_type\n        timestamp created_at\n        string title\n        text description\n        string priority\n        string status\n        timestamp completed_at\n    }\n\n    REPORT_REQUESTS_SERVICES {\n        uuid report_request_service_id PK\n        uuid report_request_id FK\n        uuid room_service_id FK\n        text issue_description\n        string item_status\n    }\n\n    REPORT_REQUESTS_FURNITURES {\n        uuid report_request_furniture_id PK\n        uuid report_request_id FK\n        uuid furniture_id FK\n        text damage_description\n        string damage_level\n        text note\n    }\n\n    REPORT_RECORDS {\n        uuid report_record_id PK\n        uuid report_request_id FK\n        uuid manager_id FK\n        timestamp handled_at\n        text work_description\n        text result\n        decimal repair_cost\n        text note\n        string status_after\n    }\n\n\n    %% =========================\n    %% STRUCTURE / ROOM\n    %% =========================\n\n    MANAGERS ||--o{ BRANCHES : manages\n    MANAGERS ||--o{ ROOMS : directly_manages\n    BRANCHES ||--o{ ROOMS : contains\n    ROOM_TYPES ||--o{ ROOMS : classifies\n\n    ROOMS ||--o{ ROOM_SLOTS : contains\n\n\n    %% =========================\n    %% TENANT / BOOKING / CONTRACT\n    %% =========================\n\n    TENANTS ||--o{ APPOINTMENT : creates\n    ROOMS ||--o{ APPOINTMENT : viewed_for\n\n    TENANTS ||--o{ BOOKINGS : creates\n    ROOMS ||--o{ BOOKINGS : booked_for\n\n    MANAGERS ||--o{ CONTRACTS : manages\n\n    BOOKINGS ||--o| CONTRACTS : initiates\n\n    CONTRACTS ||--|{ CONTRACT_TENANTS : has\n    TENANTS ||--o{ CONTRACT_TENANTS : participates_in\n\n    BOOKINGS o|--o| CONTRACT_TENANTS : sources_membership\n\n\n    %% =========================\n    %% SLOT OCCUPANCY\n    %% =========================\n\n    ROOM_SLOTS ||--o{ ROOM_SLOT_OCCUPANCIES : has_history\n    CONTRACT_TENANTS ||--o{ ROOM_SLOT_OCCUPANCIES : occupies\n\n\n    %% =========================\n    %% SERVICES\n    %% =========================\n\n    ROOMS ||--o{ ROOM_SERVICES : has\n    SERVICES ||--o{ ROOM_SERVICES : configures\n\n    ROOM_SERVICES ||--o{ ROOM_SERVICE_CHARGES : generates\n\n    CONTRACTS ||--o{ CONTRACT_SERVICES : subscribes\n    SERVICES ||--o{ CONTRACT_SERVICES : registered_as\n\n\n    %% =========================\n    %% BILLING\n    %% =========================\n\n    CONTRACTS ||--o{ INVOICES : generates\n\n    INVOICES ||--|{ INVOICE_ITEMS : contains\n\n    ROOM_SERVICE_CHARGES o|--o{ INVOICE_ITEMS : source_of\n    CONTRACT_SERVICES o|--o{ INVOICE_ITEMS : source_of\n\n    INVOICES ||--o{ PAYMENTS : receives\n    CONTRACT_TENANTS ||--o{ PAYMENTS : makes\n\n\n    %% =========================\n    %% FURNITURE\n    %% =========================\n\n    ROOMS ||--o{ FURNITURES : contains\n    FURNITURES ||--o{ FURNITURE_WARRANTIES : has\n\n\n    %% =========================\n    %% REPORT REQUESTS\n    %% =========================\n\n    TENANTS ||--o{ REPORT_REQUESTS : creates\n    ROOMS ||--o{ REPORT_REQUESTS : context_for\n\n    REPORT_REQUESTS ||--o{ REPORT_REQUESTS_SERVICES : includes\n    ROOM_SERVICES ||--o{ REPORT_REQUESTS_SERVICES : affected_room_service\n\n    REPORT_REQUESTS ||--o{ REPORT_REQUESTS_FURNITURES : includes\n    FURNITURES ||--o{ REPORT_REQUESTS_FURNITURES : affected_furniture\n\n    REPORT_REQUESTS ||--o{ REPORT_RECORDS : has_history\n    MANAGERS ||--o{ REPORT_RECORDS : handles&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RxxZS-uzKeul-Pv1gVMo-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
