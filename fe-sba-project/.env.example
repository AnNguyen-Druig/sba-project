# mock: complete local demo. hybrid: real auth/notifications/adminUsers/adminVerifications + mocked missing domains.
# real: missing endpoints produce visible errors, never mock fallback.
VITE_API_MODE=mock
VITE_API_BASE_URL=
VITE_BACKEND_PROXY_TARGET=http://localhost:8080
# Optional feature providers: mock or real.
# VITE_AUTH_PROVIDER=real
# VITE_NOTIFICATIONS_PROVIDER=real
# VITE_CATALOG_PROVIDER=mock
# VITE_LEASING_PROVIDER=mock
# VITE_PROFILE_PROVIDER=mock
# VITE_RECOVERY_PROVIDER=mock
# VITE_TENANT_PROVIDER=mock
# VITE_MANAGER_PROVIDER=mock
# VITE_OWNER_PROVIDER=mock
# VITE_ADMIN_PROVIDER=mock
# VITE_ADMIN_USERS_PROVIDER=real
# VITE_ADMIN_VERIFICATIONS_PROVIDER=real
# Tenant directory (GET /api/tenants, /api/tenants/me); defaults to the TENANT/MANAGER provider.
# VITE_TENANCIES_PROVIDER=real
# VITE_MANAGER_TENANTS_PROVIDER=real
# Furniture & warranty (/api/furnitures, room-scoped); defaults to the MANAGER provider.
# VITE_MANAGER_FURNITURES_PROVIDER=real
# Tenant maintenance (/api/maintenance-requests); defaults to the TENANT provider.
# VITE_TENANT_MAINTENANCE_PROVIDER=real
# Manager maintenance (room-scoped /api/maintenance-requests); defaults to the MANAGER provider.
# VITE_MANAGER_MAINTENANCE_PROVIDER=real
